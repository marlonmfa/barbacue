{
  "name": "@barbacue/desktop",
  "version": "1.2.1",
  "private": true,
  "description": "Administra\u00e7\u00e3o Barbacue para Windows: produtos, atendimento, pedidos, gest\u00e3o e impress\u00e3o",
  "author": "Grupo Barbacue",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "node scripts/build-renderer.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare:agent": "node scripts/prepare-agent.mjs",
    "dist:win": "npm run build:renderer && npm run prepare:agent && electron-builder --win nsis --x64 --publish never && npm run stage:web",
    "pack": "npm run build:renderer && npm run prepare:agent && electron-builder --dir --publish never",
    "smoke": "npm run build:renderer && node scripts/smoke.mjs",
    "stage:web": "node scripts/stage-web-download.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "postcss": "8.4.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.3.0"
  },
  "build": {
    "appId": "br.com.barbacue.pedidos",
    "productName": "Barbacue Pedidos",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "ui/**",
      "assets/**",
      "vendor/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Barbacue-Pedidos-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "deleteAppDataOnUninstall": false
    }
  }
}
