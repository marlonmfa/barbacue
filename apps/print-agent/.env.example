# Seguro por padrao: dry-run nao consulta, reserva nem confirma pedidos reais.
PRINT_TRANSPORT=dry-run
PRINT_API_URL=http://localhost:3000
# Gere um segredo aleatorio de pelo menos 32 caracteres, igual ao do servidor.
PRINT_AGENT_TOKEN=
# cups: fila ja instalada no macOS/Linux. tcp: impressora ESC/POS na rede local.
PRINT_CUPS_PRINTER=
# text usa o driver existente; escpos envia bytes ESC/POS sem filtro (raw).
PRINT_CUPS_FORMAT=text
PRINT_TCP_HOST=
PRINT_TCP_PORT=9100
PRINT_COLUMNS=48
# Corte desativado ate confirmar suporte no modelo da impressora.
PRINT_CUT=false
PRINT_TIMEZONE=America/Sao_Paulo
PRINT_POLL_MS=3000
PRINT_TIMEOUT_MS=10000
PRINT_STATE_DIR=.state
# Exclusao mutua local via porta loopback; nao altere para iniciar outra copia.
PRINT_LOCK_PORT=9178
