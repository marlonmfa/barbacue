# Copie para .env e preencha. Fonte única de variáveis para todo o monorepo
# (scraper + apps/web). apps/web carrega este arquivo via dotenv em next.config.ts.

# ─── Banco de dados ───
DATABASE_URL=postgresql://barbacue:barbacue@localhost:5432/barbacue

# ─── OpenAI (agente de IA do site — /api/chat) ───
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ─── Admin (apps/web /admin) ───
# Login mestre (usuário vazio + esta senha) = papel admin; bootstrap do banco.
# Contas de admin/gerente são criadas em /admin/staff (tabela staff_users).
ADMIN_PASSWORD=troque-isto
ADMIN_COOKIE_SECRET=troque-isto-em-producao
ADMIN_MASTER_PASSWORD=troque-isto

# ─── Impressão automática de pedidos do totem e QR na mesa ───
# Gere um segredo dedicado com: openssl rand -hex 32
# Use o mesmo valor no computador da cozinha (apps/print-agent/.env).
# Vazio desativa o acesso do agente; pedidos continuam na fila do banco.
PRINT_AGENT_TOKEN=

# ─── Frete por distância (configure a tarifa em /admin/delivery-settings) ───
# OpenStreetMap: serviços Nominatim e OSRM próprios ou de um provedor contratado.
# Google Maps e Apple Maps são opções de navegação; não exigem chave neste fluxo.
# URLs base sem /search nem /route/v1/driving. Não use servidores públicos de demonstração.
DELIVERY_NOMINATIM_URL=
DELIVERY_OSRM_URL=
DELIVERY_OSM_USER_AGENT=BarbacueDelivery/1.0 (contato: seu-email@dominio.com)
DELIVERY_PROVIDER_TIMEOUT_MS=8000

# ─── Bot de WhatsApp (apps/whatsapp-bot) ───
# Segredo compartilhado: o bot usa em /api/orders/history e no servidor de status;
# o painel admin usa para ler o QR de pareamento. Gere um valor aleatório forte.
BOT_API_TOKEN=troque-isto-token-aleatorio
# Onde o painel admin alcança o servidor de status do bot.
#   dev local: http://localhost:3001   •   docker-compose: http://whatsapp-bot:3001
BOT_STATUS_URL=http://localhost:3001
# Onde o bot alcança a API web.
#   dev local: http://localhost:3000   •   docker-compose: http://web:3000
WEB_BASE_URL=http://localhost:3000
# URL pública do site (links enviados ao cliente no WhatsApp). Em docker, WEB_BASE_URL
# é interno (http://web:3000) e não abre no celular do cliente — defina o domínio aqui.
#   ex.: https://lanchesdobarba.com.br
PUBLIC_SITE_URL=http://localhost:3000
# Deep-link opcional p/ finalizar no app (o orderId é anexado). Ex.: barbacue://order/
APP_DEEPLINK_BASE=

# ─── Gmail administrativo ───
# Use uma senha de app do Google (com verificação em duas etapas), nunca a senha
# principal da conta. Os valores ficam somente no servidor e não são exibidos no painel.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=Barbacue <contato@seudominio.com>

# ─── Deploy / VPS ───
HOST_VPS=
HOST_USER=root
DOMAIN=
DOMAIN_BARBA=barbacue.cog.ia.br
DOMAIN_CHELAS=chelas.hirableaiagents.com
DOMAIN_HOTDOG=barbadog.hirableaiagents.com

# ─── Cardápios externos ───
IFOOD_BARBACUE_URL=
IFOOD_BARBADOG_URL=
IFOOD_CHELAS_URL=

# ─── Integração iFood (packages/ifood) ───
# Portal do Desenvolvedor > Meus Apps > seu app > client_id / client_secret
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Vazio = três lojas cadastradas (Chelas, Barbacue e Hotdog).
# Opcional: JSON [{"id":"UUID","name":"Nome","brand":"chelas"}].
IFOOD_MERCHANTS_JSON=
# Legado: preencher restringe a uma única loja, se o JSON estiver vazio.
IFOOD_MERCHANT_ID=
# Rate limit do polling: ~1 chamada a cada 30s por loja. Não reduza.
IFOOD_POLL_INTERVAL_MS=30000
# true = simula (sem gravar pedidos, enviar ACK ou alterar o iFood)
IFOOD_DRY_RUN=true
# Monitoramento mantém confirmação comercial no gestor iFood por padrão.
IFOOD_AUTO_CONFIRM=false

# Marca dos pedidos recebidos pelo conector iFood: barbacue, barbadog ou chelas
IFOOD_BRAND=barbacue

# Padrao Repos v1 — adicoes preservando configuracao existente
PROJECT_NAME="barbacue.cog.ia.br"
APP_NAME="barbacue.cog.ia.br"
PROJECT_DOMAIN=barbacue.cog.ia.br
APP_URL=https://barbacue.cog.ia.br
OPENAI_BASE_URL=https://api.openai.com/v1
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GITHUB_TOKEN=
DELIVERY_TEST_PASSWORD=
ERP_TEST_URL=
ROLE_TEST_URL=
PLAY_CREDENTIALS=
DELIVERY_TEST_URL=
FAKE_DELIVERY_SECRET=
PRINT_LOCK_PORT=
PRINT_TIMEOUT_MS=
BARBACUE_DESKTOP_TEST_DATA=
PRINT_COLUMNS=
RESTAURANT_BRAND=
ERP_TEST_PASSWORD=
PRINT_TIMEZONE=
FAKE_DELIVERY_PORT=
ASC_BUNDLE_ID=
PORT=
ROLE_TEST_PASSWORD=
BOT_PORT=
BASE_URL=
NEXT_DIST_DIR=
ACCESS_TEST_URL=
DESKTOP_TEST_COOKIE_SECRET=
DELIVERY_FAKE_URL=
SELF_SERVICE_TEST_PASSWORD=
SESSIONS_DIR=
PLAY_PACKAGE=
ACCESS_TEST_PASSWORD=
PRINT_POLL_MS=
PRINT_TRANSPORT=
STAMP=
PRINT_CUPS_PRINTER=
TEST_LOGIN_IP=
RESTAURANT_MAESTRO_BIN=
DELIVERY_TEST_PROVIDER_URL=
SELF_SERVICE_TEST_URL=
BASE=
DESKTOP_TEST_URL=
NODE_ENV=
PRINT_TCP_HOST=
BOT_LOG_LEVEL=
DESKTOP_TEST_PASSWORD=
PRINT_API_URL=
BOT_SESSION_TTL_MS=
# Optional: delegate pairing, message transport and webhooks to zap.cog.ia.br.
# Generate the API key in Zap > Configurações > Chave de API.
ZAP_API_BASE_URL=https://zap.cog.ia.br/api/v1
ZAP_API_TOKEN=
ZAP_SESSION_ID=
ZAP_WEBHOOK_SECRET=
# URL pública que o Zap chamará; em Docker, use o domínio do site.
ZAP_WEBHOOK_URL=https://barbacue.cog.ia.br/api/webhooks/zap
DELIVERY_OSRM_URL=
PRINT_STATE_DIR=
PRINT_CUPS_FORMAT=
UNSPLASH_ACCESS_KEY=
PRINT_CUT=

# Padrao Repos v1 — adicoes preservando configuracao existente
PRINT_TCP_PORT=

# ─── Login social dos clientes (página /conta) ───────────────────────────────
# Veja apps/web/docs/LOGIN-SOCIAL.md. Botão some enquanto as duas variáveis
# do provedor estiverem vazias. Também exige ADMIN_COOKIE_SECRET.
# Instagram (somente contas Profissionais): App ID/Secret do produto
# "Instagram > API setup with Instagram login" — NÃO são os do app Meta.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Login (qualquer pessoa)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Versão da Graph API usada nas chamadas
META_GRAPH_VERSION=v23.0

# Integracao COG Mail — credenciais somente no backend
COGMAIL_API_URL=https://editais.cog.ia.br/api/mail/v1
COGMAIL_API_TOKEN=
COGMAIL_MAILBOX=contato@cog.ia.br

# Checkout /pedir: mesma conta Asaas usada no E26, segredo apenas no servidor.
# Sandbox por padrão; production deve ser definido explicitamente em produção.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# E-mail operacional para alertas de entrega do webhook (opcional se COGMAIL_MAILBOX estiver definido).
ASAAS_WEBHOOK_EMAIL=
