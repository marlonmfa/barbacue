# Copie para .env e preencha. Fonte única de variáveis para todo o monorepo
# (scraper + apps/web). apps/web carrega este arquivo via dotenv em next.config.ts.

# ─── Banco de dados ───
DATABASE_URL=postgresql://barbacue:barbacue@localhost:5432/barbacue

# ─── OpenAI (agente de IA do site — /api/chat) ───
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ─── Admin (apps/web /admin) ───
# Login mestre (usuário vazio + esta senha) = papel admin; bootstrap do banco.
# Contas de admin/gerente são criadas em /admin/staff (tabela staff_users).
ADMIN_PASSWORD=troque-isto
ADMIN_COOKIE_SECRET=troque-isto-em-producao
ADMIN_MASTER_PASSWORD=troque-isto

# ─── Bot de WhatsApp (apps/whatsapp-bot) ───
# Segredo compartilhado: o bot usa em /api/orders/history e no servidor de status;
# o painel admin usa para ler o QR de pareamento. Gere um valor aleatório forte.
BOT_API_TOKEN=troque-isto-token-aleatorio
# Onde o painel admin alcança o servidor de status do bot.
#   dev local: http://localhost:3001   •   docker-compose: http://whatsapp-bot:3001
BOT_STATUS_URL=http://localhost:3001
# Onde o bot alcança a API web.
#   dev local: http://localhost:3000   •   docker-compose: http://web:3000
WEB_BASE_URL=http://localhost:3000
# URL pública do site (links enviados ao cliente no WhatsApp). Em docker, WEB_BASE_URL
# é interno (http://web:3000) e não abre no celular do cliente — defina o domínio aqui.
#   ex.: https://lanchesdobarba.com.br
PUBLIC_SITE_URL=http://localhost:3000
# Deep-link opcional p/ finalizar no app (o orderId é anexado). Ex.: barbacue://order/
APP_DEEPLINK_BASE=

# ─── Deploy / VPS ───
HOST_VPS=
HOST_USER=root
DOMAIN=
